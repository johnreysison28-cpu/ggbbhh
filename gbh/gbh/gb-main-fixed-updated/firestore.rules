rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin check helper ───────────────────────────────
    // A user is an admin if a doc with their uid exists in /admins.
    // That collection is never writable by clients — admins must be
    // added manually via the Firebase Console.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Admins ────────────────────────────────────────────
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    // ── Users ─────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth.uid == userId;
      // Allow own profile updates, others updating followers array,
      // and admins updating ONLY the verification-related fields.
      allow update: if request.auth.uid == userId ||
        (request.auth != null &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['followers', 'following'])) ||
        (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['verificationStatus', 'kycVerified', 'verifiedAt', 'verifiedBy', 'rejectionReason']));
      allow delete: if false;
    }

    // ── Face Verification (private — never publicly readable) ──
    // Holds the raw selfie + ID capture from signup. Only the owning
    // user, or an admin reviewing the submission, may read it.
    match /faceVerifications/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Trades ────────────────────────────────────────────
    match /trades/{tradeId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likedBy', 'likes', 'commentCount', 'status'])
      );
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null &&
          request.auth.uid == resource.data.userId;
        allow update: if request.auth != null &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likedBy', 'likes']);

        match /replies/{replyId} {
          allow read: if true;
          allow create: if request.auth != null;
          allow delete: if request.auth != null &&
            request.auth.uid == resource.data.userId;
          allow update: if false;
        }
      }
    }

    // ── Trade Offers (the actual "make an offer / accept / ──
    // decline / cancel / complete" trade transaction flow) ──
    match /tradeOffers/{offerId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.offererId ||
         request.auth.uid == resource.data.tradeOwnerId);

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.offererId &&
        request.resource.data.offererId != request.resource.data.tradeOwnerId &&
        request.resource.data.status == 'pending';

      // Either side of the trade may update it (accept/decline/cancel/
      // complete), but the core identifying fields can never change.
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.offererId ||
         request.auth.uid == resource.data.tradeOwnerId) &&
        request.resource.data.offererId    == resource.data.offererId &&
        request.resource.data.tradeOwnerId == resource.data.tradeOwnerId &&
        request.resource.data.tradeId      == resource.data.tradeId;

      allow delete: if false;
    }

    // ── Chats (1-on-1 real-time messaging) ───────────────
    // chatId = sorted([uid1, uid2]).join('_')
    match /chats/{chatId} {

      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participants;

      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2;

      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participants;

      allow delete: if false;

      // ── Messages sub-collection ──────────────────────
      match /messages/{messageId} {

        // Use get() not getAfter() — the chat doc is always pre-created by
        // openChatWith() before sendMessage() is ever called.
        // getAfter() with merge:true batch writes is unreliable in Firestore rules.
        function isParticipant() {
          let chatDoc = get(/databases/$(database)/documents/chats/$(chatId));
          return chatDoc.exists && request.auth.uid in chatDoc.data.participants;
        }

        allow read: if request.auth != null && isParticipant();

        allow create: if request.auth != null &&
          isParticipant() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000;

        // Only allow flipping the read flag
        allow update: if request.auth != null &&
          isParticipant() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

        allow delete: if false;
      }
    }

    // ── Legacy conversations (backward compat) ────────────
    match /conversations/{convoId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.userIds;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.userIds;
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.userIds;

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convoId)).data.userIds;
        allow create: if request.auth != null &&
          request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convoId)).data.userIds &&
          request.resource.data.sender_id == request.auth.uid;
        allow update: if request.auth != null &&
          request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convoId)).data.userIds;
        allow delete: if false;
      }
    }

    // ── Notifications ──────────────────────────────────────
    match /notifications/{notifId} {
      allow read, update, delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }
  }
}
